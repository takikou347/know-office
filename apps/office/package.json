{
  "name": "@know-office/office",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/swagger-assets.ts && (test -f .dev.vars || cp .dev.vars.example .dev.vars) && vite",
    "build": "node --experimental-strip-types scripts/swagger-assets.ts && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:local": "for db in DB REC_2026 REC_2027 REC_2028 REC_2029 REC_2030 REC_2031; do wrangler d1 migrations apply $db --local || exit 1; done",
    "api-docs": "node --experimental-strip-types scripts/api-docs.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@know-office/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "jose": "6.2.17",
    "knowidea-css": "0.12.0",
    "knowidea-icons": "0.12.0",
    "knowidea-tokens": "0.12.0",
    "knowidea-ui": "0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261114.1",
    "@hono/node-server": "2.1.8",
    "@playwright/test": "1.65.1",
    "@simplewebauthn/server": "14.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "swagger-ui-dist": "5.34.1",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.159.0",
    "yaml": "2.9.1"
  }
}
