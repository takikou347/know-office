{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "know-office",
  "main": "src/gate/worker.ts",
  // 5 分ごとの定期ジョブは D1 の使った量を見る (ログインと記録の 3.5)。15 時 5 分 (協定世界時) は日本時間の 0 時 5 分で、前の日の勤怠の集計を作り直し、監査ログのつなぎを確かめる (社員と勤怠の 3.6、ログインと記録の 3.4)
  // 日曜の 18 時と 19 時 (協定世界時) は日本時間の月曜 3 時と 4 時で、蒸留と見つけて直す調べ (とアイデア出し) の週のバッチ処理を始める (サービスと拡張の 3.6、3.7)
  "triggers": { "crons": ["*/5 * * * *", "5 15 * * *", "0 18 * * 0", "0 19 * * 0"] },
  "compatibility_date": "2026-11-01",
  // 公開の URL は know-office.<アカウントのサブドメイン>.workers.dev で、プルリクエストごとのプレビュー URL も同じ Access の下に置く (ログインと記録の 3.8)。
  // 独自のドメインは取らないので routes を持たない。サブドメインはデプロイの時にオーナーが決め、開く URL を GitHub の変数 OFFICE_URL に置く。
  // Access を掛ける前に開いても、ゲートウェイは Access の証明の無い要求を 401 で断る
  "workers_dev": true,
  "preview_urls": true,
  // 開発環境は .dev.vars で development に替える。無い時は本物の宛先を使う。URGENT_SCAN (急ぐ故障の調べ)、DISTILL_BATCH (週の蒸留)、FINDINGS_BATCH (週の見つけて直す調べ)、IDEA_BATCH (週のアイデア出し) は Claude の費用が出るので、オーナーの はい の範囲でデプロイの時に on にする
  "vars": { "ENVIRONMENT": "production", "URGENT_SCAN": "off", "DISTILL_BATCH": "off", "FINDINGS_BATCH": "off", "IDEA_BATCH": "off" },
  // D1 の置き場。database_id は Cloudflare に作った時 (#144) に本物に替える。手元では名前だけで動く
  "d1_databases": [
    { "binding": "DB", "database_name": "know-office", "database_id": "local-db", "migrations_dir": "migrations/main" },
    { "binding": "REC_2026", "database_name": "know-office-rec-2026", "database_id": "local-rec-2026", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2027", "database_name": "know-office-rec-2027", "database_id": "local-rec-2027", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2028", "database_name": "know-office-rec-2028", "database_id": "local-rec-2028", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2029", "database_name": "know-office-rec-2029", "database_id": "local-rec-2029", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2030", "database_name": "know-office-rec-2030", "database_id": "local-rec-2030", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2031", "database_name": "know-office-rec-2031", "database_id": "local-rec-2031", "migrations_dir": "migrations/ledger" }
  ],
  // 会話の記録、社員が作ったファイル、D1 の毎日の写しの置き場。バケットは Cloudflare に作った時 (#144) に同じ名前で作る。手元では名前だけで動く
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "know-office-files" }],
  "durable_objects": {
    "bindings": [
      { "name": "RECORDER", "class_name": "RecorderDO" },
      { "name": "GUARD", "class_name": "GuardDO" },
      { "name": "STAFF", "class_name": "StaffDO" },
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "LIVE", "class_name": "LiveDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RecorderDO", "GuardDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StaffDO"] },
    { "tag": "v3", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v4", "new_sqlite_classes": ["LiveDO"] }
  ],
  // ワークスペースのコンテナ。社員 1 人に 1 つ、CPU 4 分の 1 個とメモリ 1GB (basic) から始める (アーキテクチャの 3.3)
  // イメージは know-office の全体を置き場にして作る。ワークスペースが core を読むため
  "containers": [{ "class_name": "WorkspaceDO", "image": "../workspace/Dockerfile", "image_build_context": "../..", "instance_type": "basic", "max_instances": 3 }],
  // 開発の実行と e2e は Docker が無くても動かす。コンテナを確かめる時は、これを外した設定で wrangler dev を起こす
  "dev": { "enable_containers": false },
  // プルリクエストごとのプレビュー (wrangler preview --name pr-<番号>)。D1 と R2 は既定で本番と共有されるので、プレビュー用の置き場に替える。
  // 年ごとの記録の置き場はプレビューでは 1 つにまとめる。DO はプレビューごとに分けた名前空間で動く。ワークスペースはプレビューでは起こさない (技術とインフラの 4 章)
  "previews": {
    "vars": { "ENVIRONMENT": "preview", "URGENT_SCAN": "off", "DISTILL_BATCH": "off", "FINDINGS_BATCH": "off", "IDEA_BATCH": "off" },
    "d1_databases": [
      { "binding": "DB", "database_name": "know-office-preview", "migrations_dir": "migrations/main" },
      { "binding": "REC_2026", "database_name": "know-office-preview-rec", "migrations_dir": "migrations/ledger" },
      { "binding": "REC_2027", "database_name": "know-office-preview-rec", "migrations_dir": "migrations/ledger" },
      { "binding": "REC_2028", "database_name": "know-office-preview-rec", "migrations_dir": "migrations/ledger" },
      { "binding": "REC_2029", "database_name": "know-office-preview-rec", "migrations_dir": "migrations/ledger" },
      { "binding": "REC_2030", "database_name": "know-office-preview-rec", "migrations_dir": "migrations/ledger" },
      { "binding": "REC_2031", "database_name": "know-office-preview-rec", "migrations_dir": "migrations/ledger" }
    ],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "know-office-preview-files" }],
    "durable_objects": {
      "bindings": [
        { "name": "RECORDER", "class_name": "RecorderDO" },
        { "name": "GUARD", "class_name": "GuardDO" },
        { "name": "STAFF", "class_name": "StaffDO" },
        { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
        { "name": "LIVE", "class_name": "LiveDO" }
      ]
    }
  },
  "assets": {
    // /api の下、GitHub の通知の道、/__dev の下 (開発の代わりのワークスペースの道。development の時だけ受け、ほかでは 404) を入口が受け、ほかは画面のファイルを返す
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/v1/github", "/__dev/*"]
  }
}
