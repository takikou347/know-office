{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "know-office",
  "main": "src/gate/worker.ts",
  // 5 分ごとの定期ジョブは D1 の使った量を見る (ログインと記録の 3.5)。15 時 5 分 (協定世界時) は日本時間の 0 時 5 分で、前の日の勤怠の集計を作り直す (社員と勤怠の 3.6)
  "triggers": { "crons": ["*/5 * * * *", "5 15 * * *"] },
  "compatibility_date": "2026-11-01",
  // Cloudflare が自動で付ける、Access を通らない URL は切る
  "workers_dev": false,
  "preview_urls": false,
  // 開発環境は .dev.vars で development に替える。無い時は本物の宛先を使う
  "vars": { "ENVIRONMENT": "production" },
  // D1 の置き場。database_id は Cloudflare に作った時 (tasks.md の 4.8) に本物に替える。手元では名前だけで動く
  "d1_databases": [
    { "binding": "DB", "database_name": "know-office", "database_id": "local-db", "migrations_dir": "migrations/main" },
    { "binding": "REC_2026", "database_name": "know-office-rec-2026", "database_id": "local-rec-2026", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2027", "database_name": "know-office-rec-2027", "database_id": "local-rec-2027", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2028", "database_name": "know-office-rec-2028", "database_id": "local-rec-2028", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2029", "database_name": "know-office-rec-2029", "database_id": "local-rec-2029", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2030", "database_name": "know-office-rec-2030", "database_id": "local-rec-2030", "migrations_dir": "migrations/ledger" },
    { "binding": "REC_2031", "database_name": "know-office-rec-2031", "database_id": "local-rec-2031", "migrations_dir": "migrations/ledger" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RECORDER", "class_name": "RecorderDO" },
      { "name": "GUARD", "class_name": "GuardDO" },
      { "name": "STAFF", "class_name": "StaffDO" },
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RecorderDO", "GuardDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StaffDO"] },
    { "tag": "v3", "new_sqlite_classes": ["WorkspaceDO"] }
  ],
  // ワークスペースのコンテナ。社員 1 人に 1 つ、CPU 4 分の 1 個とメモリ 1GB (basic) から始める (アーキテクチャの 3.3)
  // イメージは know-office の全体を置き場にして作る。ワークスペースが core を読むため
  "containers": [{ "class_name": "WorkspaceDO", "image": "../workspace/Dockerfile", "image_build_context": "../..", "instance_type": "basic", "max_instances": 3 }],
  // 開発の実行と e2e は Docker が無くても動かす。コンテナを確かめる時は、これを外した設定で wrangler dev を起こす
  "dev": { "enable_containers": false },
  "assets": {
    // /api の下だけ入口が受け、ほかは画面のファイルを返す
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
