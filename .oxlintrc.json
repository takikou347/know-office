{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // コード規約のチェックで守れる所。決まりの全量は knowidea の services/know-office/docs/05-conventions.md
  "plugins": ["typescript", "react", "import", "vitest", "unicorn", "jsdoc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-namespace": "error",
    "typescript/consistent-type-imports": "error",
    "eqeqeq": "error",
    "prefer-const": "error",
    "no-var": "error",
    "no-param-reassign": "error",
    "no-console": "error",
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/no-nested-ternary": "error",
    // 条件は肯定の形で書く。否定は早く返す時だけ
    "unicorn/no-negated-condition": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    // JSDoc を書いた関数は、引数と返す物の説明をそろえる
    "jsdoc/require-param": "error",
    "jsdoc/require-param-name": "error",
    "jsdoc/require-param-description": "error",
    "jsdoc/require-returns": "error",
    "jsdoc/require-returns-description": "error",
    "jsdoc/check-tag-names": "error",
    "jsdoc/empty-tags": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      // ログの出口はここだけ。ほかは log() を通して鍵を伏せる
      "files": ["packages/core/src/log.ts"],
      "rules": { "no-console": "off" }
    },
    {
      // 仮のデータのモック。tasks.md の 8.8 で画面ごとのファイル (screen/pages/<画面>/) に分ける時にこの例外を消す
      "files": ["apps/office/src/screen/pages.tsx"],
      "rules": { "max-lines": "off" }
    },
    {
      // Swagger UI の初期化 (GitHub Pages とゲートウェイの /api/v1/docs)。ブラウザが先に読んだ swagger-ui-bundle.js の大域の関数を呼ぶ
      "files": ["apps/office/openapi/pages/*.js", "apps/office/public/swagger/*.js"],
      "rules": { "typescript/no-unsafe-assignment": "off", "typescript/no-unsafe-call": "off" }
    },
    {
      // 型の食い違いを @ts-expect-error で確かめるファイル。わざと誤った値を置く
      "files": ["**/*.types.ts"],
      "rules": { "typescript/no-unsafe-assignment": "off" }
    },
    {
      // React のコンポーネントのファイルはコンポーネントの名前と同じ PascalCase。コンポーネントは引数の代わりに props の型の項目に JSDoc を書く
      "files": ["**/*.tsx"],
      "rules": {
        "unicorn/filename-case": ["error", { "cases": { "pascalCase": true, "kebabCase": true } }],
        "jsdoc/require-param": "off",
        "jsdoc/require-returns": "off"
      }
    },
    {
      // 共通パッケージは Workers と Node の両方で動く物だけにする
      "files": ["packages/core/src/**"],
      "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["node:*", "cloudflare:*", "drizzle-orm", "drizzle-orm/*", "hono", "hono/*"], "message": "core は Workers と Node の両方で動く物だけを読む" }] }] }
    },
    {
      // 画面はゲートウェイの型だけを読み、テーブルや鍵の扱いを読まない
      "files": ["apps/office/src/screen/**"],
      "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["drizzle-orm", "drizzle-orm/*", "cloudflare:*", "**/gate/db/*", "**/gate/do/*"], "message": "画面はゲートウェイの型を Hono の RPC で受ける" }] }] }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/.wrangler/**", "**/node_modules/**", "apps/office/public/swagger/swagger-ui-bundle.js"]
}
