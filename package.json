{
  "name": "know-office",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "test": "pnpm -r test && node --test scripts/*.test.ts",
    "build": "pnpm -r build",
    "lint": "oxlint --type-aware --deny-warnings",
    "verify": "node scripts/verify.ts",
    "dev": "pnpm --filter @know-office/office dev",
    "e2e": "pnpm --filter @know-office/office e2e",
    "clean": "rm -rf apps/*/dist apps/*/.wrangler apps/*/test-results apps/*/playwright-report"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  }
}
